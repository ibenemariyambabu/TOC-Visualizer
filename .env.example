# JWT Secret for Authentication
JWT_SECRET="toc-super-secret-jwt-key-2024-ktu-scheme"

# Google Gemini API Key for AI Tutor & Solver
GEMINI_API_KEY=""

# Frontend URL for CORS
FRONTEND_URL="http://localhost:5173"
